FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Gowin EDA dependencies
RUN apt-get update && apt-get install -y \
    wget \
    libgomp1 \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    libgl1-mesa-glx \
    ghdl \
    iverilog \
    gtkwave \
    bambu \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install Gowin EDA
# Download installer from Gowin and place in same folder as this Dockerfile
COPY GowinEDA_V1.9.9_linux.tar.gz /tmp/
RUN tar -xzf /tmp/GowinEDA_V1.9.9_linux.tar.gz -C /opt/ \
    && rm /tmp/GowinEDA_V1.9.9_linux.tar.gz

ENV PATH="/opt/gowin/IDE/bin:/opt/gowin/Programmer/bin:$PATH"

WORKDIR /workspace