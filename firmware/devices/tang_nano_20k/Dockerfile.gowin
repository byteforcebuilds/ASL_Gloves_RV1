FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Gowin EDA dependencies
RUN apt-get update && apt-get install -y \
    wget \
    libgomp1 \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    libgl1-mesa-glx \
    ghdl \
    iverilog \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Build argument for Gowin EDA installer filename
ARG GOWIN_INSTALLER=GowinEDA_V1.9.9_linux.tar.gz

# Install Gowin EDA
# Download installer from Gowin and place in same folder as this Dockerfile
COPY ${GOWIN_INSTALLER} /tmp/
RUN cd /opt \
    && tar -xzf /tmp/${GOWIN_INSTALLER} \
    && rm /tmp/${GOWIN_INSTALLER} \
    && (ls -d /opt/*/bin 2>/dev/null | xargs dirname | head -1 | xargs -I {} mv {} /opt/gowin || echo "Gowin already at /opt/gowin")

ENV PATH="/opt/gowin/bin:/opt/gowin/IDE/bin:/opt/gowin/Programmer/bin:$PATH" \
    LM_LICENSE_FILE=10559@106.55.34.119

WORKDIR /workspace